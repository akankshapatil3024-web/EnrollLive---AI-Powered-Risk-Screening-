{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "enum": ["DOCTOR", "PATIENT"] },
        "name": { "type": "string", "maxLength": 128 },
        "patientId": { "type": "string", "maxLength": 64 },
        "specialty": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "role", "name"]
    },
    "Patient": {
      "title": "Patient",
      "description": "Patient medical and readmission risk record",
      "type": "object",
      "properties": {
        "patientId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "age": { "type": "integer" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "medicalCondition": { "type": "string", "maxLength": 128 },
        "admissionType": { "type": "string", "enum": ["Emergency", "Elective", "Urgent", "Trauma"] },
        "lengthOfStay": { "type": "integer" },
        "previousVisits": { "type": "integer" },
        "numMedications": { "type": "integer" },
        "numProcedures": { "type": "integer" },
        "numDiagnoses": { "type": "integer" },
        "primaryDiagnosis": { "type": "string", "maxLength": 256 },
        "assignedDoctorId": { "type": "string", "maxLength": 128 },
        "assignedDoctorName": { "type": "string", "maxLength": 128 },
        "riskScore": { "type": "integer" },
        "riskLevel": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "lastScreeningDate": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["patientId", "name", "age", "medicalCondition", "admissionType", "lengthOfStay", "assignedDoctorId"]
    },
    "Screening": {
      "title": "Screening",
      "description": "Machine learning readmission risk assessment screening event",
      "type": "object",
      "properties": {
        "screeningId": { "type": "string", "maxLength": 64 },
        "patientId": { "type": "string", "maxLength": 64 },
        "patientUid": { "type": "string", "maxLength": 128 },
        "doctorId": { "type": "string", "maxLength": 128 },
        "doctorName": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 64 },
        "riskScore": { "type": "integer" },
        "riskLevel": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "factors": { "type": "array" },
        "suggestions": { "type": "array" },
        "modelVersion": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["screeningId", "patientId", "doctorId", "riskScore", "riskLevel", "date"]
    },
    "Report": {
      "title": "Report",
      "description": "Formal clinical decision-support report for patient readmission risk",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "maxLength": 64 },
        "screeningId": { "type": "string", "maxLength": 64 },
        "patientId": { "type": "string", "maxLength": 64 },
        "patientUid": { "type": "string", "maxLength": 128 },
        "patientName": { "type": "string", "maxLength": 128 },
        "doctorId": { "type": "string", "maxLength": 128 },
        "doctorName": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 64 },
        "riskScore": { "type": "integer" },
        "riskLevel": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "clinicalSummary": { "type": "string", "maxLength": 2048 },
        "factors": { "type": "array" },
        "monitoringPlan": { "type": "array" },
        "disclaimer": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["reportId", "patientId", "doctorId", "riskScore", "riskLevel", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles identifying roles (DOCTOR or PATIENT)"
    },
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "Patient hospital records assigned to a doctor and linked to patient account"
    },
    "/screenings/{screeningId}": {
      "schema": "Screening",
      "description": "Risk screening evaluations generated by doctors for patients"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Generated clinical decision-support reports"
    }
  }
}
