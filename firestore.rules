rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || resource.data.role == 'DOCTOR');
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
    }

    // Patients Collection
    match /patients/{patientDocId} {
      allow get: if isSignedIn() && (
        resource.data.assignedDoctorId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.assignedDoctorId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        request.resource.data.assignedDoctorId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.assignedDoctorId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow delete: if isSignedIn() && resource.data.assignedDoctorId == request.auth.uid;
    }

    // Screenings Collection
    match /screenings/{screeningDocId} {
      allow get: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid ||
        resource.data.patientUid == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid ||
        resource.data.patientUid == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.doctorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.doctorId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.doctorId == request.auth.uid;
    }

    // Reports Collection
    match /reports/{reportDocId} {
      allow get: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid ||
        resource.data.patientUid == request.auth.uid
      );
      allow list: if isSignedIn() && (
        resource.data.doctorId == request.auth.uid ||
        resource.data.patientUid == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.doctorId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.doctorId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.doctorId == request.auth.uid;
    }
  }
}
